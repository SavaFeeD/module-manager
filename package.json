{
  "name": "@savafeed/module-manager",
  "version": "1.2.2",
  "description": "js modules solution",
  "main": "dist/index.cjs.js",
  "module": "dist/index.esm.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build:config": "tsc -p tsconfig.rollup.json && mv rollup.config.js rollup.config.mjs",
    "build": "npm run clean && npm run build:config && rollup -c && rm rollup.config.mjs",
    "build:prod": "npm run clean && npm run build:config && NODE_ENV=production rollup -c && rm rollup.config.mjs",
    "watch": "npm run clean && npm run build:config && rollup -c -w && rm rollup.config.mjs",
    "test": "npm run build && node dist_test/index.cjs.js",
    "clean:dist": "npx rimraf dist",
    "clean:dist-test": "npx rimraf dist_test",
    "clean": "npm run clean:dist && npm run clean:dist-test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "engines": {
    "node": ">=24.18.0"
  },
  "keywords": [],
  "author": "Alexander (SavaFeeD) Shachnev",
  "license": "ISC",
  "devDependencies": {
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/node": "^26.1.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.2.0",
    "prettier": "^3.9.6",
    "rollup": "^4.62.2",
    "rollup-plugin-dts": "^6.4.1",
    "rollup-plugin-visualizer": "^7.0.1",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "reflect-metadata": "^0.2.2"
  },
  "lint-staged": {
    "*.{js,ts,json,md}": [
      "prettier --write"
    ]
  }
}
